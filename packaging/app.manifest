<?xml version="1.0" encoding="utf-8"?>
<!--
  Side-by-side (fusion) manifest embedded into the built NotificationForwarder.exe
  via PyInstaller. The <msix> element's publisher/packageName/applicationId must
  match Identity.Publisher, Identity.Name, and the Application Id in
  packaging/AppxManifest.xml exactly, or the exe will run with no package
  identity even after the sparse package is registered.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="NotificationForwarder" type="win32" />

  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=WinNotiForwarder"
        packageName="WinNotiForwarder"
        applicationId="NotificationForwarder" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>
</assembly>
